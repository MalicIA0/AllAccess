{
  "name": "gamevault",
  "version": "0.6.40",
  "description": "Hub de jeux local premium â€” Steam, Xbox & Game Pass, succÃ¨s et notifications",
  "main": "out/main/index.js",
  "author": "Jean-Denis Cuenin",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "framer-motion": "^12.23.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3"
  },
  "build": {
    "appId": "com.jdc.allaccess",
    "productName": "All Access",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "resources/**",
      "!resources/perf/**"
    ],
    "extraResources": [
      {
        "from": "resources/perf",
        "to": "perf"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "All Access",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "All Access Setup ${version}.exe",
      "uninstallDisplayName": "All Access"
    }
  }
}
